{
  "name": "searchbarkit",
  "private": true,
  "version": "3.2.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:playground": "pnpm dev:web",
    "dev:manga": "pnpm build:packages && pnpm --filter @searchbarkit/manga-demo dev",
    "dev:pokemon": "pnpm build:packages && pnpm --filter @searchbarkit/pokemon-demo dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @searchbarkit/core test && pnpm --filter @searchbarkit/config test && pnpm --filter @searchbarkit/react test",
    "test:core": "pnpm --filter @searchbarkit/core test",
    "test:ui": "pnpm --filter @searchbarkit/react test",
    "dev:library": "pnpm build:packages && pnpm --filter @searchbarkit/library-demo dev",
    "dev:web-component": "pnpm build:packages && pnpm --filter @searchbarkit/web-component-demo dev",
    "typecheck:config": "pnpm --filter @searchbarkit/config typecheck",
    "test:config": "pnpm --filter @searchbarkit/config test",
    "build:web-component": "pnpm --filter @searchbarkit/web-component build",
    "check": "pnpm build:packages && pnpm test && pnpm typecheck && pnpm registry:check && pnpm build:apps && pnpm registry:smoke && pnpm pages:check",
    "build:packages": "pnpm --filter @searchbarkit/core build && pnpm --filter @searchbarkit/config build && pnpm --filter @searchbarkit/react build && pnpm --filter @searchbarkit/web-component build",
    "build:apps": "pnpm registry:build && pnpm --filter \"./apps/*\" --if-present build",
    "pack:packages": "node scripts/pack-packages.mjs",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release:verify": "node scripts/release-verify.mjs",
    "release:prepare": "pnpm check && pnpm release:verify && pnpm pack:packages && pnpm smoke:consumer",
    "lockfile:generate": "pnpm install --lockfile-only --no-frozen-lockfile",
    "lockfile:verify": "node scripts/verify-lockfile.mjs",
    "dev:web": "pnpm build:packages && pnpm --filter @searchbarkit/web dev",
    "dev:gallery": "pnpm dev:web",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:check": "node scripts/sync-registry.mjs --check",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:smoke": "node scripts/smoke-registry.mjs",
    "pages:check": "node scripts/check-pages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@changesets/cli": "^2.29.0"
  },
  "license": "MIT"
}
