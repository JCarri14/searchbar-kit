        {"path":"registry/searchbar.core.url-state.ts","type":"registry:ui","target":"@ui/searchbar.core.url-state.ts"},
        {"path":"registry/searchbar.core.options.ts","type":"registry:ui","target":"@ui/searchbar.core.options.ts"},
